#!/bin/bash
# clamshell-keepawake — give your MacBook a grace period before it sleeps.
#
# One command for the whole lifecycle. The hidden `_tick` subcommand is what the
# LaunchDaemon runs every 60s; everything else is for humans:
#
#   sudo clamshell-keepawake install [hours]   install/enable (default 3h)
#   sudo clamshell-keepawake uninstall         remove, re-enable normal sleep
#   sudo clamshell-keepawake set <hours>       change the grace period
#   sudo clamshell-keepawake pause [dur]       opt out (until 'resume', or e.g. 30m)
#   sudo clamshell-keepawake resume            cancel a pause
#        clamshell-keepawake status            show current state
#        clamshell-keepawake logs              follow the daemon log
#
# No `set -e`: the _tick logic relies on `cond && action` lines and a `grep -c`
# that exits non-zero on a 0 count, which are correct as written but would abort
# under -e. The mutating steps that must succeed use explicit `|| die`.
set -uo pipefail

LABEL="com.clamshellkeepawake"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
BIN="/usr/local/bin/clamshell-keepawake"
CONF="/usr/local/etc/clamshell-keepawake.conf"
LOG="/var/log/clamshell-keepawake.log"

# Runtime state (created by the daemon as root; world-readable so `status` works
# without sudo).
CLOSED_SINCE="/var/run/clamshell-keepawake.closed-since"
OPEN_SINCE="/var/run/clamshell-keepawake.open-since"
DONE="/var/run/clamshell-keepawake.done"
PREV_LID="/var/run/clamshell-keepawake.prev-lid"
PAUSED="/var/run/clamshell-keepawake.paused"
SUDOERS="/etc/sudoers.d/clamshell-keepawake"
PLUGIN_NAME="clamshell-keepawake.5s.sh"

DEFAULT_HOURS=3

# ---- small helpers --------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "this command needs root. Re-run: sudo clamshell-keepawake ${1:-<cmd>}"
}

# The GUI user to scope per-user actions to. Uses $SUDO_USER when run via sudo,
# else the current console user (so it also works when launched as root by the
# Spotlight app via osascript, where $SUDO_USER is unset).
target_user() {
    echo "${SUDO_USER:-$(stat -f%Su /dev/console 2>/dev/null)}"
}

# Seconds -> "2 h 14 m" / "45 m" / "30 s".
fmt_dur() {
    local s="$1" h m
    h=$(( s / 3600 )); m=$(( (s % 3600) / 60 ))
    if [ "$h" -gt 0 ]; then
        if [ "$m" -gt 0 ]; then echo "${h} h ${m} m"; else echo "${h} h"; fi
    elif [ "$m" -gt 0 ]; then
        echo "${m} m"
    else
        echo "${s} s"
    fi
}

# Duration string -> seconds. Accepts <number>[s|m|h]; no suffix = minutes.
parse_duration() {
    local in="$1" num unit
    [[ "$in" =~ ^([0-9]+(\.[0-9]+)?)([smh]?)$ ]] || return 1
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[3]}"
    case "$unit" in
        s)     awk -v n="$num" 'BEGIN{printf "%d", n+0.5}' ;;
        h)     awk -v n="$num" 'BEGIN{printf "%d", n*3600+0.5}' ;;
        m|"")  awk -v n="$num" 'BEGIN{printf "%d", n*60+0.5}' ;;
    esac
}

clear_state() { rm -f "$CLOSED_SINCE" "$OPEN_SINCE" "$PREV_LID" "$DONE" "$PAUSED"; }

# Current grace period in seconds (conf overrides the built-in default).
hold_seconds() {
    local HOLD=$(( DEFAULT_HOURS * 3600 ))
    [ -r "$CONF" ] && . "$CONF"
    echo "$HOLD"
}

lid_state() {
    if ioreg -r -k AppleClamshellState -d 4 | grep -q '"AppleClamshellState" = Yes'; then
        echo closed
    else
        echo open
    fi
}

# Count connected external displays (meaningful when the lid is shut).
external_count() {
    system_profiler SPDisplaysDataType 2>/dev/null | grep -c "Resolution:" || true
}

# Seconds until the Mac may sleep given the current state, or empty when there
# is no active countdown (clamshell+monitor, grace already elapsed, etc.).
# Mirrors the decision cmd_tick makes; read-only.
remaining_seconds() {
    local now HOLD lid idle_ns idle since_open left
    now=$(date +%s)
    HOLD=$(hold_seconds)
    lid=$(lid_state)
    if [ "$lid" = open ]; then
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        if [ -f "$OPEN_SINCE" ]; then
            since_open=$(( now - $(cat "$OPEN_SINCE") ))
            [ "$since_open" -lt "$idle" ] && idle=$since_open
        fi
        left=$(( HOLD - idle ))
        [ "$left" -gt 0 ] && echo "$left"
    elif [ "$(external_count)" -gt 0 ]; then
        :   # clamshell with monitor: no countdown
    elif [ -f "$CLOSED_SINCE" ]; then
        left=$(( HOLD - ( now - $(cat "$CLOSED_SINCE") ) ))
        [ "$left" -gt 0 ] && echo "$left"
    fi
}

# ---- configuration / files ------------------------------------------------

# Write conf + matching pmset timers for HOURS. Leaves APPLIED_HOLD / APPLIED_DISP
# set for the caller's summary.
apply_duration() {
    local HOURS="$1" HOLD_SECONDS SLEEP_MIN DISP_MIN
    awk -v h="$HOURS" 'BEGIN{exit !(h+0>0)}' \
        || die "HOURS must be a positive number (got '${HOURS}')"
    HOLD_SECONDS=$(awk -v h="$HOURS" 'BEGIN{printf "%d", (h*3600)+0.5}')
    SLEEP_MIN=$(awk -v s="$HOLD_SECONDS" 'BEGIN{m=int((s/60)+0.5); if(m<1)m=1; print m}')
    DISP_MIN=$(awk -v m="$SLEEP_MIN" 'BEGIN{ if(m>10) print 10; else {d=m-1; if(d<1)d=1; print d} }')

    install -d -m 755 /usr/local/etc
    printf 'HOLD=%s\n' "$HOLD_SECONDS" > "$CONF"
    chmod 644 "$CONF"

    # Idle sleep timer == grace period, so the lid-open case sleeps when the
    # daemon releases `disablesleep`. disksleep matched for consistency.
    pmset -a sleep "$SLEEP_MIN"
    pmset -a disksleep "$SLEEP_MIN"
    pmset -a displaysleep "$DISP_MIN"

    APPLIED_HOLD=$HOLD_SECONDS
    APPLIED_DISP=$DISP_MIN
}

write_plist() {
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BIN}</string>
        <string>_tick</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOG}</string>
    <key>StandardErrorPath</key>
    <string>${LOG}</string>
</dict>
</plist>
PLIST
    chmod 644 "$PLIST"
    chown root:wheel "$PLIST"
}

# ---- _tick: the per-60s worker (run as root by launchd) -------------------
#
# Delay any natural system sleep by the grace period, then ALLOW (not force) it,
# resetting whenever the computer is used again. `disablesleep` is held on so a
# lid-close can't race us to sleep; at the grace mark we set it 0 and let macOS
# sleep on its own. Because we only *allow* sleep, a power assertion (playback,
# a download, screen sharing) still keeps the Mac awake past the mark, which is
# correct: that sleep wasn't going to happen normally either.
cmd_tick() {
    local now HOLD lid prev idle_ns idle since_open ext until
    now=$(date +%s)

    # ---- Pause guard: while paused, behave like a normal Mac ----
    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" != indefinite ] && [ "$until" -le "$now" ] 2>/dev/null; then
            rm -f "$PAUSED"                  # expired -> fall through to normal logic
        else
            pmset -a disablesleep 0          # paused -> let macOS sleep normally
            return 0
        fi
    fi

    HOLD=10800
    [ -r "$CONF" ] && . "$CONF"

    lid=$(lid_state)
    prev=$(cat "$PREV_LID" 2>/dev/null || true)
    echo "$lid" > "$PREV_LID"

    if [ "$lid" = open ]; then
        # ---- Lid OPEN ----
        rm -f "$CLOSED_SINCE" "$DONE"
        if [ "$prev" != open ]; then
            echo "$now" > "$OPEN_SINCE"          # just opened/woke/first run = in use
        fi
        [ -f "$OPEN_SINCE" ] || echo "$now" > "$OPEN_SINCE"
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        since_open=$(( now - $(cat "$OPEN_SINCE") ))
        [ "$since_open" -lt "$idle" ] && idle=$since_open   # idle = min(HID idle, time open)
        if [ "$idle" -ge "$HOLD" ]; then
            pmset -a disablesleep 0
        else
            pmset -a disablesleep 1
        fi
    else
        # ---- Lid SHUT (built-in panel off -> this counts external monitors) ----
        rm -f "$OPEN_SINCE"
        ext=$(system_profiler SPDisplaysDataType 2>/dev/null | grep -c "Resolution:")
        if [ "$ext" -gt 0 ]; then
            rm -f "$CLOSED_SINCE" "$DONE"        # clamshell work: stay awake, no countdown
            pmset -a disablesleep 1
        elif [ -f "$DONE" ]; then
            :                                    # already released this session; hands off
        elif [ ! -f "$CLOSED_SINCE" ]; then
            echo "$now" > "$CLOSED_SINCE"        # just unplugged / closed with no monitor
            pmset -a disablesleep 1
        elif [ $(( now - $(cat "$CLOSED_SINCE") )) -ge "$HOLD" ]; then
            rm -f "$CLOSED_SINCE"
            touch "$DONE"
            pmset -a disablesleep 0              # grace up: lid shut -> macOS sleeps now
        else
            pmset -a disablesleep 1
        fi
    fi
}

# ---- install / uninstall / set --------------------------------------------

print_install_summary() {
    local HOURS="$1" awake awake_human
    echo "Installed and loaded ${LABEL}."
    awake=$(pmset -g | awk '/SleepDisabled/{print $2; exit}')
    if [ "${awake:-0}" = 1 ]; then
        awake_human="yes -- a keep-awake window is active right now"
    else
        awake_human="no -- normal sleep is in effect right now"
    fi
    echo
    echo "What's now in effect:"
    echo "  - Grace period: stays awake ${HOURS} hour(s) before it's allowed to sleep."
    echo "  - Lid open, left alone: screen off after ${APPLIED_DISP} min; sleeps after the"
    echo "    grace period. Using it again resets the timer."
    echo "  - Lid shut WITH a monitor (clamshell): stays awake, no timer."
    echo "  - Lid shut with NO monitor (closed, or monitor unplugged): stays awake the"
    echo "    grace period, then sleeps. Opening the lid or reconnecting a monitor resets it."
    echo "  - Keeping the Mac awake right now? ${awake_human}"
    echo "  - A background helper re-checks every 60 seconds."
    echo
    echo "Check state anytime:   clamshell-keepawake status"
    echo "Change the duration:   sudo clamshell-keepawake set <hours>"
}

cmd_install() {
    need_root install
    local HOURS="${1:-}" src
    if [ -z "$HOURS" ]; then
        if [ -r "$CONF" ]; then
            HOURS=$(awk -v s="$(hold_seconds)" 'BEGIN{printf "%g", s/3600}')   # reuse existing grace
        elif [ -e /dev/tty ]; then
            printf 'Hours to stay awake before sleeping [%s]: ' "$DEFAULT_HOURS" > /dev/tty
            read -r HOURS < /dev/tty || true
        fi
        HOURS="${HOURS:-$DEFAULT_HOURS}"
    fi

    # Resolve our own path so we can copy onto PATH (skip if already there).
    case "$0" in
        */*) src=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
        *)   src=$(command -v "$0") ;;
    esac
    install -d -m 755 /usr/local/bin
    if [ "$src" != "$BIN" ]; then
        install -m 755 -o root -g wheel "$src" "$BIN" || die "could not install ${BIN}"
    fi

    apply_duration "$HOURS"
    write_plist
    clear_state

    launchctl bootout system "$PLIST" 2>/dev/null || true
    launchctl bootstrap system "$PLIST" || die "launchctl bootstrap failed"

    print_install_summary "$HOURS"
}

# Stop the daemon, remove its plist + state + menu artifacts, and restore normal
# sleep. Shared by quit and uninstall.
teardown() {
    launchctl bootout system "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    clear_state

    # Remove menu artifacts (sudoers rule + SwiftBar plugin) if menu-setup ran.
    # No SwiftBar refresh here: deleting the plugin file is enough (SwiftBar
    # watches the folder), and a refresh URL would pop SwiftBar to the front.
    rm -f "$SUDOERS"
    local user dir
    user=$(target_user)
    if [ -n "$user" ]; then
        dir=$(swiftbar_plugin_dir "$user")
        [ -n "$dir" ] && rm -f "$dir/$PLUGIN_NAME"
    fi

    pmset -a disablesleep 0    # restore normal sleep
}

cmd_uninstall() {
    need_root uninstall
    teardown
    rm -f "$BIN"
    echo "Removed ${LABEL} and re-enabled normal sleep."
    echo "Note: the sleep / disksleep / displaysleep timers set during install were"
    echo "left as-is. Set display-off in System Settings > Lock Screen, or use pmset."
}

# Stop everything but keep the binary installed (re-enable later with install).
cmd_quit() {
    need_root quit
    teardown
    echo "clamshell-keepawake stopped; normal sleep restored."
    echo "Still installed — re-enable anytime with: sudo clamshell-keepawake install"
}

cmd_set() {
    need_root "set <hours>"
    local HOURS="${1:-}" hh was_paused=no
    [ -n "$HOURS" ] || die "usage: sudo clamshell-keepawake set <hours>"
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo clamshell-keepawake install ${HOURS}"
    [ -f "$PAUSED" ] && was_paused=yes      # note it before clear_state removes it
    apply_duration "$HOURS"
    clear_state                 # also cancels any active pause
    cmd_tick                    # re-arm immediately instead of waiting up to 60s
    hh=$(awk -v s="$APPLIED_HOLD" 'BEGIN{printf "%g", s/3600}')
    if [ "$was_paused" = yes ]; then
        echo "Resumed; grace period now ${hh} h (screen off after ${APPLIED_DISP} min)."
    else
        echo "Grace period set to ${hh} h (screen off after ${APPLIED_DISP} min)."
    fi
}

# ---- pause / resume -------------------------------------------------------

cmd_pause() {
    need_root pause
    local arg="${1:-}" secs until
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo clamshell-keepawake install"
    if [ -z "$arg" ]; then
        echo indefinite > "$PAUSED"
        echo "Paused. Normal sleep is in effect until you run: clamshell-keepawake resume"
    else
        secs=$(parse_duration "$arg") || die "bad duration '${arg}' (try 30m, 2h, 90s)"
        until=$(( $(date +%s) + secs ))
        echo "$until" > "$PAUSED"
        echo "Paused for $(fmt_dur "$secs") (until $(date -r "$until" +%H:%M)). Resume early: clamshell-keepawake resume"
    fi
    chmod 644 "$PAUSED"
    cmd_tick                    # apply immediately (tick sees the pause file)
}

cmd_resume() {
    need_root resume
    if [ ! -f "$PAUSED" ]; then
        echo "Not paused — nothing to resume."
        return 0
    fi
    rm -f "$PAUSED"
    cmd_tick                    # re-arm immediately
    echo "Resumed. Keep-awake is active again."
}

# ---- status / logs --------------------------------------------------------

# Best-effort phrase for how much longer the Mac will stay awake (used by
# status). Builds on remaining_seconds so status/title/menu agree.
awake_remaining() {
    local secs
    secs=$(remaining_seconds)
    if [ -n "$secs" ]; then
        if [ "$(lid_state)" = open ]; then
            echo "sleeps in ~$(fmt_dur "$secs") if left idle"
        else
            echo "sleeps in ~$(fmt_dur "$secs")"
        fi
    elif [ "$(lid_state)" != open ] && [ "$(external_count)" -gt 0 ]; then
        echo "clamshell with monitor — no countdown"
    fi
}

cmd_status() {
    local hours now until left awake phrase
    hours=$(awk -v s="$(hold_seconds)" 'BEGIN{printf "%g", s/3600}')
    now=$(date +%s)

    if [ -f "$PLIST" ]; then
        echo "clamshell-keepawake: installed"
    else
        echo "clamshell-keepawake: not installed (run: sudo clamshell-keepawake install)"
    fi
    echo "  Grace period:  ${hours} h"
    echo "  Lid:           $(lid_state)"

    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" = indefinite ]; then
            echo "  Paused:        yes (until you run 'resume')"
        else
            left=$(( until - now ))
            if [ "$left" -gt 0 ]; then
                echo "  Paused:        yes ($(fmt_dur "$left") left)"
            else
                echo "  Paused:        expiring on next check"
            fi
        fi
    else
        echo "  Paused:        no"
    fi

    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')
    if [ "${awake:-0}" = 1 ]; then
        phrase=$(awake_remaining)
        if [ -n "$phrase" ]; then
            echo "  Keeping awake: yes  (${phrase})"
        else
            echo "  Keeping awake: yes"
        fi
    else
        echo "  Keeping awake: no (normal sleep in effect)"
    fi
}

# Emit a SwiftBar menu: title line, then ---, then info + action lines.
# Read-only (no root). Action items shell out to sudo clamshell-keepawake ...,
# made prompt-free by the sudoers drop-in that menu-setup installs.
cmd_menu() {
    local paused awake

    if [ ! -f "$PLIST" ]; then
        echo "⚠️"
        echo "---"
        echo "Not installed"
        echo "Run: sudo clamshell-keepawake install"
        return 0
    fi

    [ -f "$PAUSED" ] && paused=yes || paused=no
    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')

    # ---- Title (icon only): sun = holding awake, moon = not (off or paused) ----
    if [ "${awake:-0}" = 1 ] && [ "$paused" = no ]; then
        echo "☀"
    else
        echo "🌙"
    fi
    echo "---"

    # ---- Info ----
    if [ "$paused" = yes ]; then
        echo "Paused"
    else
        echo "Active"
    fi
    echo "Grace period: $(awk -v s="$(hold_seconds)" 'BEGIN{printf "%g", s/3600}') h"
    echo "---"

    # ---- Pause/Resume toggle ----
    if [ "$paused" = yes ]; then
        echo "Resume | bash=/usr/bin/sudo param1=$BIN param2=resume terminal=false refresh=true"
    else
        echo "Pause | bash=/usr/bin/sudo param1=$BIN param2=pause terminal=false refresh=true"
    fi

    # ---- Set grace period submenu ----
    echo "Set grace period"
    echo "--1 hour | bash=/usr/bin/sudo param1=$BIN param2=set param3=1 terminal=false refresh=true"
    echo "--2 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=2 terminal=false refresh=true"
    echo "--3 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=3 terminal=false refresh=true"
    echo "--4 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=4 terminal=false refresh=true"
    echo "--Custom… | bash=$BIN param1=set-prompt terminal=false refresh=true"
    echo "---"

    # ---- Footer ----
    echo "Open log | bash=/usr/bin/open param1=$LOG terminal=false"
    echo "Refresh | refresh=true"
    echo "---"
    echo "Quit clamshell-keepawake | bash=/usr/bin/sudo param1=$BIN param2=quit terminal=false"
}

# Custom… menu action: prompt for hours, then apply via sudo set.
# Runs as the user (SwiftBar); sudo is prompt-free via the menu sudoers rule.
cmd_set_prompt() {
    local hours
    hours=$(osascript -e 'set h to text returned of (display dialog "Hours to stay awake before sleeping:" default answer "3" with title "clamshell-keepawake")' 2>/dev/null) || return 0
    [ -n "$hours" ] || return 0
    sudo "$BIN" set "$hours"
}

# ---- menu setup / teardown ------------------------------------------------

# Write the scoped, passwordless sudoers rule for the menu's three actions.
# Validated with visudo before being moved into place (a bad sudoers file can
# break sudo system-wide).
write_sudoers() {
    local user="$1" tmp
    tmp=$(mktemp) || die "mktemp failed"
    printf '%s ALL=(root) NOPASSWD: %s pause, %s resume, %s set *, %s quit\n' \
        "$user" "$BIN" "$BIN" "$BIN" "$BIN" > "$tmp"
    if visudo -cf "$tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g wheel "$tmp" "$SUDOERS"
        rm -f "$tmp"
    else
        rm -f "$tmp"
        die "generated sudoers content failed validation; not installing"
    fi
}

# SwiftBar's configured plugin folder, read as the target user.
swiftbar_plugin_dir() {
    sudo -u "$1" defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null
}

# Generate the thin SwiftBar plugin (calls our menu subcommand). The metadata
# comments hide SwiftBar's own footer items (its menu section, About, Run in
# Terminal, Last Updated, Disable Plugin) for a clean dropdown.
write_plugin() {
    local dir="$1" user="$2" path
    path="$dir/$PLUGIN_NAME"
    cat > "$path" <<PLUGIN
#!/bin/bash
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
exec ${BIN} menu
PLUGIN
    chmod 0755 "$path"
    chown "$user" "$path"
}

cmd_menu_setup() {
    need_root menu-setup
    local user dir
    user=$(target_user)
    [ -n "$user" ] || die "couldn't determine your user account to scope the sudoers rule"
    [ -f "$PLIST" ] || die "install first: sudo clamshell-keepawake install"

    write_sudoers "$user"
    echo "Installed passwordless sudo rule for ${user} (pause / resume / set)."

    dir=$(swiftbar_plugin_dir "$user")
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        echo "SwiftBar plugin folder not found."
        echo "Install SwiftBar (https://swiftbar.app), set its Plugin Folder, then re-run:"
        echo "  sudo clamshell-keepawake menu-setup"
        return 0
    fi
    write_plugin "$dir" "$user"
    sudo -u "$user" open -g -a SwiftBar 2>/dev/null || true   # ensure SwiftBar is running
    echo "Installed SwiftBar plugin to ${dir}/${PLUGIN_NAME}."
    echo "The clamshell-keepawake item should appear in your menu bar."
}

cmd_menu_remove() {
    need_root menu-remove
    local user dir
    user=$(target_user)
    rm -f "$SUDOERS"
    if [ -n "$user" ]; then
        dir=$(swiftbar_plugin_dir "$user")
        [ -n "$dir" ] && rm -f "$dir/$PLUGIN_NAME"
        sudo -u "$user" open -g "swiftbar://refreshallplugins" 2>/dev/null || true
    fi
    echo "Removed the menu sudo rule and SwiftBar plugin."
}

cmd_logs() {
    [ -f "$LOG" ] || die "no log yet at ${LOG} (is it installed?)"
    exec tail -f "$LOG"
}

# ---- usage / dispatch -----------------------------------------------------

usage() {
    cat <<EOF
clamshell-keepawake — give your MacBook a grace period before it sleeps.

Usage:
  sudo clamshell-keepawake install [hours]   Install/enable (default ${DEFAULT_HOURS}h; prompts if omitted)
  sudo clamshell-keepawake uninstall         Remove and re-enable normal sleep
  sudo clamshell-keepawake quit              Stop everything + restore sleep, but keep it installed
  sudo clamshell-keepawake set <hours>       Change the grace period (e.g. 1.5)
  sudo clamshell-keepawake menu-setup        Add the SwiftBar menu bar item (+ passwordless sudo for it)
  sudo clamshell-keepawake menu-remove       Remove the menu bar item and its sudo rule
  sudo clamshell-keepawake pause [dur]       Opt out until 'resume', or for a while (e.g. 30m, 2h)
  sudo clamshell-keepawake resume            Cancel a pause
       clamshell-keepawake status            Show current state
       clamshell-keepawake logs              Follow the daemon log
       clamshell-keepawake help              This help
EOF
}

case "${1:-help}" in
    install)        shift; cmd_install "$@" ;;
    uninstall)      shift; cmd_uninstall "$@" ;;
    quit)           cmd_quit ;;
    set)            shift; cmd_set "$@" ;;
    pause)          shift; cmd_pause "$@" ;;
    resume)         shift; cmd_resume "$@" ;;
    status)         shift; cmd_status "$@" ;;
    menu)           cmd_menu ;;
    set-prompt)     cmd_set_prompt ;;
