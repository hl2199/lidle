#!/bin/bash
# lidle — give your MacBook an awake window before it sleeps.
#
# One command for the whole lifecycle. The hidden `_tick` subcommand is what the
# LaunchDaemon runs every 60s; everything else is for humans:
#
#   sudo lidle install [hours]   install/enable (prompts for hours)
#   sudo lidle uninstall         remove, re-enable normal sleep
#   sudo lidle set <hours>       change the awake window
#   sudo lidle pause [dur]       opt out (until 'resume', or e.g. 30m)
#   sudo lidle resume            cancel a pause
#        lidle status            show current state
#        lidle logs              follow the daemon log
#
# No `set -e`: the _tick logic relies on `cond && action` lines and a `grep -c`
# that exits non-zero on a 0 count, which are correct as written but would abort
# under -e. The mutating steps that must succeed use explicit `|| die`.
set -uo pipefail

LABEL="com.lidle"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
BIN="/usr/local/bin/lidle"
CONF="/usr/local/etc/lidle.conf"
SAVED_PMSET="/usr/local/etc/lidle.saved-pmset"
LOG="/var/log/lidle.log"

# Runtime state (created by the daemon as root; world-readable so `status` works
# without sudo).
CLOSED_SINCE="/var/run/lidle.closed-since"
OPEN_SINCE="/var/run/lidle.open-since"
DONE="/var/run/lidle.done"
PREV_LID="/var/run/lidle.prev-lid"
PAUSED="/var/run/lidle.paused"
MODE="/var/run/lidle.mode"
EXT_CACHE="/var/run/lidle.ext-count"
EXT_CONFIRM="/var/run/lidle.ext-confirm"
RELEASED_AT="/var/run/lidle.released-at"
SUDOERS="/etc/sudoers.d/lidle"
PLUGIN_NAME="lidle.5s.sh"
AGENT_LABEL="com.lidle.menu"

VERSION="1.1.0"

# ---- small helpers --------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "this command needs root. Re-run: sudo lidle ${1:-<cmd>}"
}

# The GUI user to scope per-user actions to. Uses $SUDO_USER when run via sudo,
# else the current console user (so it also works when launched as root by the
# Spotlight app via osascript, where $SUDO_USER is unset).
target_user() {
    echo "${SUDO_USER:-$(stat -f%Su /dev/console 2>/dev/null)}"
}

# Absolute path of the script that is currently running.
self_path() {
    case "$0" in
        */*) printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")" ;;
        *)   command -v "$0" 2>/dev/null ;;
    esac
}

# The version the background service is actually running, but only when it
# differs from the copy you just invoked; empty otherwise.
#
# `install` copies the script to $BIN and the LaunchDaemon execs that absolute
# path forever after. A package upgrade replaces whatever is on PATH -- Homebrew
# installs into its own prefix, which precedes /usr/local/bin -- so the lidle you
# type gets newer while the root daemon keeps running the old build, silently and
# indefinitely. Surfacing it is the difference between a stale daemon you notice
# and one you don't.
version_drift() {
    local self installed
    [ -x "$BIN" ] || return 0
    self=$(self_path)
    [ -n "$self" ] && [ "$self" != "$BIN" ] || return 0
    installed=$("$BIN" version 2>/dev/null | awk '{print $2}')
    [ -n "$installed" ] && [ "$installed" != "$VERSION" ] || return 0
    printf '%s\n' "$installed"
}

# Nudge SwiftBar to re-render the menu now.
#
# SwiftBar's own `refresh=true` fires as soon as it launches the action, not
# when the action finishes, so it re-renders before `set`/`pause`/`resume` have
# changed anything and the menu shows stale values until the next 5s poll.
# Call this once the new state has settled instead.
#
# Runs as the console user because root has no GUI session to open a URL in, and
# no-ops when the menu isn't installed so command-line-only users never see a
# stray `open`. The plugin name is derived from PLUGIN_NAME so the URL can't
# drift if the plugin file is ever renamed.
refresh_menu() {
    local user
    [ -f "$SUDOERS" ] || return 0
    user=$(target_user); [ -n "$user" ] || return 0
    sudo -u "$user" open -g "swiftbar://refreshplugin?name=${PLUGIN_NAME%%.*}" 2>/dev/null || true
}

# Seconds -> "2 h 14 m" / "45 m" / "30 s".
fmt_dur() {
    local s="$1" h m
    h=$(( s / 3600 )); m=$(( (s % 3600) / 60 ))
    if [ "$h" -gt 0 ]; then
        if [ "$m" -gt 0 ]; then echo "${h} h ${m} m"; else echo "${h} h"; fi
    elif [ "$m" -gt 0 ]; then
        echo "${m} m"
    else
        echo "${s} s"
    fi
}

# Duration string -> seconds. Accepts <number>[s|m|h]; no suffix = minutes.
parse_duration() {
    local in="$1" num unit
    [[ "$in" =~ ^([0-9]+(\.[0-9]+)?)([smh]?)$ ]] || return 1
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[3]}"
    case "$unit" in
        s)     awk -v n="$num" 'BEGIN{printf "%d", n+0.5}' ;;
        h)     awk -v n="$num" 'BEGIN{printf "%d", n*3600+0.5}' ;;
        m|"")  awk -v n="$num" 'BEGIN{printf "%d", n*60+0.5}' ;;
    esac
}

clear_state() { rm -f "$CLOSED_SINCE" "$OPEN_SINCE" "$PREV_LID" "$DONE" "$PAUSED" "$MODE" "$EXT_CACHE" "$EXT_CONFIRM" "$RELEASED_AT"; }

# Append a timestamped line to the log, but only when the worker's mode actually
# changes (the daemon ticks every 60s; without this the log would repeat the same
# line forever). $1 is a short mode key compared against the last one; $2 is the
# human-readable line. Writes straight to $LOG so inline ticks don't print to the
# terminal.
log_mode() {
    local mode="$1" prev
    prev=$(cat "$MODE" 2>/dev/null || true)
    [ "$mode" = "$prev" ] && return 0
    echo "$mode" > "$MODE"
    printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$2" >> "$LOG"
}

# Current awake window from the config: seconds, the literal "indefinite", or
# empty when unconfigured (there is no built-in default — it's set at install).
hold_seconds() {
    local HOLD=""
    [ -r "$CONF" ] && . "$CONF"
    echo "$HOLD"
}

# Awake window for display: "not set", "indefinite", or e.g. "3 h".
hold_human() {
    local h
    h=$(hold_seconds)
    if   [ -z "$h" ];            then echo "not set"
    elif [ "$h" = indefinite ];  then echo indefinite
    else awk -v s="$h" 'BEGIN{printf "%g h", s/3600}'; fi
}

lid_state() {
    # Capture ioreg's output and string-match it rather than piping into `grep -q`:
    # grep -q exits on the first match and SIGPIPEs ioreg (exit 141), which
    # `set -o pipefail` then surfaces as a pipeline failure — making the `if`
    # wrongly fall through and report "open" while the lid is actually shut.
    case "$(ioreg -r -k AppleClamshellState -d 4)" in
        *'"AppleClamshellState" = Yes'*) echo closed ;;
        *)                               echo open ;;
    esac
}

# Count connected external displays (meaningful when the lid is shut).
#
# Excludes the placeholder framebuffer macOS keeps alive when the lid is shut
# with no real display attached: because lidle holds the machine awake, the
# window server still needs a display context, so system_profiler reports a
# nameless 1920x1080 display whose EDID ids are the ASCII markers "unkn"
# (vendor 0x756e6b6e) and "virt" (product 0x76697274). It is otherwise
# indistinguishable from a real monitor -- same fields, same "Resolution:" line
# -- so counting it made every lid-shut session look like clamshell mode and the
# awake window never counted down.
#
# It must also exclude the BUILT-IN panel. When the lid shuts on a machine with
# no external display, macOS does not always substitute the placeholder -- if the
# internal panel was the only display, it simply stays enumerated, with a genuine
# Apple EDID (Color LCD, vendor 0x610). Counting that is what turned a bounded
# lid-shut window into an unbounded clamshell hold and ran a battery flat. The
# marker is `spdisplays_connection_type: spdisplays_internal`, which the built-in
# has and neither a real external nor the placeholder does.
#
# The JSON form is required: neither the EDID ids nor the connection type are in
# the human-readable output. `_spdisplays_display-vendor-id` occurs exactly once
# per display (the GPU object uses a different key), so it delimits the blocks.
external_count() {
    system_profiler SPDisplaysDataType -json 2>/dev/null | awk '
        function flush() { if (have && !skip) n++; have = 0; skip = 0 }
        /"_spdisplays_display-vendor-id"/ {
            flush(); have = 1
            if ($0 ~ /756e6b6e/) skip = 1                 # placeholder ("unkn")
            next
        }
        /"spdisplays_connection_type" *: *"spdisplays_internal"/ { skip = 1 }
        END { flush(); print n + 0 }
    '
}

# Current power source: "battery" or "ac".
power_source() {
    case "$(pmset -g batt 2>/dev/null)" in
        *"'Battery Power'"*) echo battery ;;
        *)                   echo ac ;;
    esac
}

# Internal battery charge as a whole-number percent. Returns 100 when there is
# no battery or the value can't be parsed, so a desktop Mac (or a parse failure)
# never trips the floor and starts allowing sleep.
battery_pct() {
    local p
    p=$(pmset -g batt 2>/dev/null | awk '/InternalBattery/{
            for (i = 1; i <= NF; i++) if ($i ~ /%/) { gsub(/[^0-9]/, "", $i); print $i; exit }
        }')
    case "${p:-}" in
        ''|*[!0-9]*) echo 100 ;;
        *)           echo "$p" ;;
    esac
}

# Set `disablesleep` only when it differs from the current value. The tick runs
# every 60s; re-issuing an unchanged value still pushes a request through the
# power-management stack, so guarding it avoids needless per-tick churn while
# preserving correctness (any external drift is still corrected on the next tick).
set_disablesleep() {
    local want="$1" cur
    cur=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')
    [ "$cur" = "$want" ] && return 0
    pmset -a disablesleep "$want"
}

# external_count() with light caching. Per-tick clamshell detection needs the
# display count, but system_profiler is a heavy display-subsystem enumeration;
# caching lets the 60s tick reuse the last count, re-reading only when forced
# (the lid just shut) or when the cache is older than EXT_TTL. A monitor plugged
# or unplugged while already lid-shut is noticed within EXT_TTL — acceptable,
# since lidle only delays sleep, and it also rides out the transient enumeration
# blips that would otherwise read as a spurious "no monitor".
EXT_TTL=300
cached_external_count() {
    local force="${1:-}" now ts cnt
    now=$(date +%s)
    if [ "$force" != force ] && [ -r "$EXT_CACHE" ]; then
        read -r ts cnt < "$EXT_CACHE" || true
        case "${ts:-}" in
            ''|*[!0-9]*) ;;                                  # no/garbled cache -> refresh
            *) [ "$(( now - ts ))" -lt "$EXT_TTL" ] && { echo "$cnt"; return 0; } ;;
        esac
    fi
    cnt=$(external_count)
    printf '%s %s\n' "$now" "$cnt" > "$EXT_CACHE"
    echo "$cnt"
}

# True (0) when a pause is in effect right now. Read-only and honors a timed
# pause's expiry, so status/menu don't keep showing "paused" past its end (the
# daemon reaps the file on its next tick).
paused_now() {
    local until
    [ -f "$PAUSED" ] || return 1
    until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
    [ "$until" = indefinite ] && return 0
    [ "$until" -gt "$(date +%s)" ] 2>/dev/null
}

# Seconds until the Mac may sleep given the current state, or empty when there
# is no active countdown (clamshell+monitor, awake window already elapsed, etc.).
# Mirrors the decision cmd_tick makes; read-only.
remaining_seconds() {
    local now HOLD lid idle_ns idle since_open left
    now=$(date +%s)
    HOLD=$(hold_seconds)
    [ -z "$HOLD" ] && return 0               # unconfigured -> no countdown
    [ "$HOLD" = indefinite ] && return 0     # never sleeps -> no countdown
    lid=$(lid_state)
    if [ "$lid" = open ]; then
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        if [ -f "$OPEN_SINCE" ]; then
            since_open=$(( now - $(cat "$OPEN_SINCE") ))
            [ "$since_open" -lt "$idle" ] && idle=$since_open
        fi
        left=$(( HOLD - idle ))
        [ "$left" -gt 0 ] && echo "$left"
    elif [ "$(external_count)" -gt 0 ]; then
        :   # clamshell with monitor: no countdown
    elif [ -f "$CLOSED_SINCE" ]; then
        left=$(( HOLD - ( now - $(cat "$CLOSED_SINCE") ) ))
        [ "$left" -gt 0 ] && echo "$left"
    fi
}

# ---- configuration / files ------------------------------------------------

# Snapshot the user's current sleep timers (AC + battery) the first time we touch
# them, so uninstall/quit can put back exactly what was there. A no-op once the
# snapshot exists, so re-installing or changing the awake window never clobbers
# the true originals.
save_pmset() {
    [ -e "$SAVED_PMSET" ] && return 0
    install -d -m 755 /usr/local/etc
    pmset -g custom | awk '
        /^AC Power:/      { src="c"; next }
        /^Battery Power:/ { src="b"; next }
        src && $1=="sleep"        { print src, "sleep", $2 }
        src && $1=="disksleep"    { print src, "disksleep", $2 }
    ' > "$SAVED_PMSET"
    chmod 644 "$SAVED_PMSET"
}

# Put the snapshotted sleep timers back. No-op if we never captured them.
restore_pmset() {
    [ -r "$SAVED_PMSET" ] || return 0
    local src key val
    while read -r src key val; do
        [ -n "$src" ] && pmset -"$src" "$key" "$val"
    done < "$SAVED_PMSET"
}

# Point pmset's idle timers at the configured awake window.
#
# Idle sleep timer == awake window, so the lid-open case sleeps when the daemon
# releases `disablesleep`. disksleep matched for consistency. displaysleep
# (screen-off) is left untouched -- it follows the user's macOS display
# settings, including any changes they make later.
#
# Split out of apply_duration so `resume` (and a timed pause's expiry) can put
# these back after `pause` handed them to the user's originals. Reads the conf,
# so callers must write it first.
apply_sleep_timers() {
    local h min
    h=$(hold_seconds)
    [ -n "$h" ] || return 0
    if [ "$h" = indefinite ]; then
        pmset -a sleep 0            # 0 = never idle-sleep
        pmset -a disksleep 0
        return 0
    fi
    min=$(awk -v s="$h" 'BEGIN{m=int((s/60)+0.5); if(m<1)m=1; print m}')
    pmset -a sleep "$min"
    pmset -a disksleep "$min"
}

# Write conf + matching pmset timers for HOURS. Leaves APPLIED_HOLD set for the
# caller's summary.
apply_duration() {
    local HOURS="$1" HOLD_SECONDS
    if [ "$HOURS" = indefinite ]; then
        install -d -m 755 /usr/local/etc
        printf 'HOLD=indefinite\n' > "$CONF"; chmod 644 "$CONF"
        save_pmset                  # capture the originals once, before we overwrite
        apply_sleep_timers
        APPLIED_HOLD=indefinite
        return 0
    fi
    awk -v h="$HOURS" 'BEGIN{exit !(h+0>0)}' \
        || die "HOURS must be a positive number or 'indefinite' (got '${HOURS}')"
    HOLD_SECONDS=$(awk -v h="$HOURS" 'BEGIN{printf "%d", (h*3600)+0.5}')

    install -d -m 755 /usr/local/etc
    printf 'HOLD=%s\n' "$HOLD_SECONDS" > "$CONF"
    chmod 644 "$CONF"

    save_pmset                  # capture the originals once, before we overwrite
    apply_sleep_timers

    APPLIED_HOLD=$HOLD_SECONDS
}

write_plist() {
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BIN}</string>
        <string>_tick</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOG}</string>
    <key>StandardErrorPath</key>
    <string>${LOG}</string>
</dict>
</plist>
PLIST
    chmod 644 "$PLIST"
    chown root:wheel "$PLIST"
}

# ---- _tick: the per-60s worker (run as root by launchd) -------------------
#
# Delay any natural system sleep by the awake window, then ALLOW (not force) it,
# resetting whenever the computer is used again. `disablesleep` is held on so a
# lid-close can't race us to sleep; at the awake-window mark we set it 0 and let
# macOS sleep on its own -- but only for as long as that sleep might actually
# land, because while it is 0 a lid close sleeps instantly with no window at all.
# Because we only *allow* sleep, a power assertion (playback, a download, screen
# sharing) still keeps the Mac awake past the mark, which is correct: that sleep
# wasn't going to happen normally either.
#
# How long to wait before re-offering an idle sleep the Mac declined to take.
# See the lid-open branch: we only sit with `disablesleep` off for the one tick
# it takes macOS to act, then re-arm so a lid close still gets its window.
RELEASE_RETRY=1800
#
# Charge below which we stop holding the Mac awake on battery. This is a
# backstop, not a feature: a misread anywhere else -- lid state, display count --
# turns a bounded hold into an unbounded one, and on battery that ends with the
# machine flat. Keep it low enough that normal use is unaffected.
BATTERY_FLOOR=15
cmd_tick() {
    local now HOLD lid prev idle_ns idle since_open ext until last
    now=$(date +%s)

    # ---- Pause guard: while paused, behave like a normal Mac ----
    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" != indefinite ] && [ "$until" -le "$now" ] 2>/dev/null; then
            rm -f "$PAUSED"                  # expired -> fall through to normal logic
            apply_sleep_timers               # and take the idle timers back over
        else
            log_mode paused "paused — letting macOS sleep normally"
            set_disablesleep 0               # paused -> let macOS sleep normally
            return 0
        fi
    fi

    # ---- Battery floor: never hold the Mac awake into a dead battery ----
    # Deliberately ahead of every other branch, including `indefinite` and
    # clamshell: those are the modes with no countdown at all, so they are
    # exactly the ones that flatten a battery when something upstream misreads.
    if [ "$(power_source)" = battery ] && [ "$(battery_pct)" -lt "$BATTERY_FLOOR" ]; then
        log_mode battery-floor "battery below ${BATTERY_FLOOR}% on battery power — letting macOS sleep normally"
        set_disablesleep 0
        return 0
    fi

    HOLD=""
    [ -r "$CONF" ] && . "$CONF"

    # ---- No window configured (missing/empty conf): behave like a normal Mac ----
    if [ -z "$HOLD" ]; then
        log_mode unconfigured "no awake window configured — letting macOS sleep normally"
        set_disablesleep 0
        return 0
    fi

    # ---- Indefinite awake window: hold awake forever, never count down ----
    if [ "$HOLD" = indefinite ]; then
        log_mode indefinite "awake window is indefinite — holding awake (never sleeps)"
        set_disablesleep 1
        return 0
    fi

    lid=$(lid_state)
    prev=$(cat "$PREV_LID" 2>/dev/null || true)
    echo "$lid" > "$PREV_LID"

    if [ "$lid" = open ]; then
        # ---- Lid OPEN ----
        rm -f "$CLOSED_SINCE" "$DONE"
        if [ "$prev" != open ]; then
            echo "$now" > "$OPEN_SINCE"          # just opened/woke/first run = in use
        fi
        [ -f "$OPEN_SINCE" ] || echo "$now" > "$OPEN_SINCE"
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        since_open=$(( now - $(cat "$OPEN_SINCE") ))
        [ "$since_open" -lt "$idle" ] && idle=$since_open   # idle = min(HID idle, time open)
        if [ "$idle" -ge "$HOLD" ]; then
            # Window elapsed with the lid open. Dropping `disablesleep` is what
            # lets macOS take its idle sleep -- but it also unguards a lid close,
            # which would then sleep instantly with no window at all, and once
            # asleep this daemon cannot run to correct it.
            #
            # macOS acts on the release within seconds when nothing else holds
            # the machine awake, so offer it for a single tick and then re-arm:
            # still being here on the next tick means something (playback, a
            # download, a backup) is holding the Mac awake and the idle sleep is
            # not going to happen, so there is nothing to gain by staying
            # unguarded. Re-offer periodically so the Mac still sleeps once that
            # lets go. We never force sleep -- an assertion always wins, which is
            # the same contract as before; this only bounds how long we sit
            # exposed waiting for a sleep that isn't coming.
            last=$(cat "$RELEASED_AT" 2>/dev/null || echo 0)
            case "$last" in ''|*[!0-9]*) last=0 ;; esac
            if [ "$(( now - last ))" -ge "$RELEASE_RETRY" ]; then
                echo "$now" > "$RELEASED_AT"
                log_mode open-idle "lid open, idle past the awake window — sleep allowed"
                set_disablesleep 0
            else
                log_mode open-idle-held "lid open, idle past the window but something is holding the Mac awake — re-armed so a lid close still gets its window"
                set_disablesleep 1
            fi
        else
            rm -f "$RELEASED_AT"                     # fresh idle episode next time
            log_mode open-hold "lid open — holding awake (awake window running)"
            set_disablesleep 1
        fi
    else
        # ---- Lid SHUT (built-in panel off -> this counts external monitors) ----
        rm -f "$OPEN_SINCE" "$RELEASED_AT"
        # Lid just shut -> read displays fresh; already shut -> reuse the cached
        # count (a hotplug while shut is caught within EXT_TTL).
        if [ "$prev" = closed ]; then ext=$(cached_external_count); else ext=$(cached_external_count force); fi
        [ "$ext" -gt 0 ] || rm -f "$EXT_CONFIRM"
        if [ "$ext" -gt 0 ]; then
            # Require two consecutive sightings before believing a monitor
            # appeared. A 5 h window needs ~60 consecutive clean reads, and any
            # single one deletes CLOSED_SINCE outright, silently restarting the
            # countdown from zero. Hold awake while confirming -- that direction
            # errs toward staying awake, which is the safe one.
            if [ -f "$EXT_CONFIRM" ]; then
                rm -f "$CLOSED_SINCE" "$DONE"    # clamshell work: stay awake, no countdown
                log_mode clamshell "lid shut with external monitor (displays=${ext}) — holding awake (clamshell)"
            else
                touch "$EXT_CONFIRM"
            fi
            set_disablesleep 1
        elif [ -f "$DONE" ]; then
            log_mode shut-done "lid shut, no monitor, awake window elapsed — sleep allowed"
            # already released this session; hands off (no pmset change)
        elif [ ! -f "$CLOSED_SINCE" ]; then
            echo "$now" > "$CLOSED_SINCE"        # just unplugged / closed with no monitor
            log_mode shut-hold "lid shut, no monitor — holding awake (awake window running)"
            set_disablesleep 1
        elif [ $(( now - $(cat "$CLOSED_SINCE") )) -ge "$HOLD" ]; then
            rm -f "$CLOSED_SINCE"
            touch "$DONE"
            log_mode shut-done "lid shut, no monitor, awake window elapsed — sleep allowed"
            set_disablesleep 0              # window up: lid shut -> macOS sleeps now
        else
            log_mode shut-hold "lid shut, no monitor — holding awake (awake window running)"
            set_disablesleep 1
        fi
    fi
}

# ---- install / uninstall / set --------------------------------------------

print_install_summary() {
    local HOURS="$1"
    echo "Installed and loaded lidle."
    echo
    if [ "${HOURS}" = indefinite ]; then
        echo "Your Mac now stays awake whenever it would otherwise sleep -- closing the"
        echo "lid, unplugging a monitor, or sitting idle -- with no time limit, until you"
        echo "change the window or pause."
        echo
        echo "Heads up: a closed MacBook with no external display stays awake (and warm)"
        echo "the whole time -- keep an eye on it."
    else
        echo "Your Mac now waits ${HOURS} hour(s) before sleeping whenever it would"
        echo "otherwise sleep -- closing the lid, unplugging a monitor, or sitting idle."
        echo "After that it sleeps as usual; using it again resets the timer."
        echo
        echo "Heads up: while the window is active, a closed MacBook with no external"
        echo "display stays awake (and warm) until the window ends -- keep an eye on it."
    fi
    echo
    echo "Check state anytime:  lidle status   (or the menu bar item)"
}

cmd_install() {
    need_root install
    # Warn (don't block) if there's no lid/clamshell sensor — lidle
    # is meant for MacBooks, but a false negative must never stop a real install.
    # Match the captured string, not `... | grep -q` (see lid_state for why).
    case "$(ioreg -r -k AppleClamshellState -d 4)" in
        *AppleClamshellState*) : ;;
        *) echo "warning: no lid sensor detected; lidle is meant for" >&2
           echo "         MacBooks. Continuing anyway." >&2 ;;
    esac
    # Treat every install as a first-time setup: always ask for the awake window
    # (or require it as an argument), never silently reuse a prior config. We do
    # not assume the user still wants their previous preference.
    local HOURS="${1:-}" src reply
    if [ -z "$HOURS" ] && { : < /dev/tty; } 2>/dev/null; then     # a real terminal we can prompt on
        printf 'Hours to stay awake before sleeping, or "indefinite": ' > /dev/tty
        read -r HOURS < /dev/tty || true
    fi
    [ -n "$HOURS" ] || die "no awake window given. Pass hours (e.g. 'sudo lidle install 3') or 'indefinite'."

    # Resolve our own path so we can copy onto PATH (skip if already there).
    src=$(self_path)
    install -d -m 755 /usr/local/bin
    if [ "$src" != "$BIN" ]; then
        install -m 755 -o root -g wheel "$src" "$BIN" || die "could not install ${BIN}"
    fi

    apply_duration "$HOURS"
    write_plist
    clear_state

    launchctl bootout system "$PLIST" 2>/dev/null || true
    launchctl bootstrap system "$PLIST" || die "launchctl bootstrap failed"

    print_install_summary "$HOURS"

    # On an interactive install, offer the menu bar item (skip when it's already
    # set up, or when running non-interactively / scripted).
    if [ ! -f "$SUDOERS" ] && tty_available; then
        printf '\nAdd the menu bar item now? [Y/n] ' > /dev/tty
        read -r reply < /dev/tty || reply=n
        case "$reply" in
            ''|[Yy]*) echo; cmd_menu_setup ;;
            *) echo "Skipped. Add it later with: sudo lidle menu-setup" ;;
        esac
    fi
}

# Stop the daemon, remove its plist + state + menu artifacts, and restore normal
# sleep. Shared by quit and uninstall.
teardown() {
    launchctl bootout system "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    clear_state

    # Remove menu artifacts (sudoers rule, SwiftBar plugin, login agent) if
    # menu-setup ran. No SwiftBar refresh URL here: deleting the plugin file is
    # enough (SwiftBar watches the folder) and a refresh URL would pop it forward.
    remove_menu_artifacts "$(target_user)"

    restore_pmset              # put the original sleep / disksleep timers back
    pmset -a disablesleep 0    # and re-enable normal sleep
}

cmd_uninstall() {
    need_root uninstall
    teardown
    rm -f "$BIN" "$SAVED_PMSET" "$CONF" "$LOG"   # full wipe (quit keeps conf/log)
    echo "Removed ${LABEL}, re-enabled normal sleep, and restored the sleep /"
    echo "disksleep timers to the values you had before installing."

    # Confirm a clean removal: every file/service lidle creates should be gone.
    local f clean=yes
    for f in "$PLIST" "$BIN" "$CONF" "$SAVED_PMSET" "$LOG" "$SUDOERS" \
             "$CLOSED_SINCE" "$OPEN_SINCE" "$DONE" "$PREV_LID" "$PAUSED" "$MODE" \
             "$EXT_CACHE" "$EXT_CONFIRM" "$RELEASED_AT"; do
        [ -e "$f" ] || continue
        [ "$clean" = yes ] && { echo; echo "warning: these artifacts are still present:"; }
        clean=no; echo "  $f"
    done
    if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
        [ "$clean" = yes ] && { echo; echo "warning: these artifacts are still present:"; }
        clean=no; echo "  daemon still loaded: ${LABEL}"
    fi
    [ "$clean" = yes ] && echo "Verified: all lidle files and services removed."
}

# Stop everything but keep the binary installed (re-enable later with install).
cmd_quit() {
    need_root quit
    teardown
    echo "lidle stopped; normal sleep restored."
    echo "Still installed — re-enable anytime with: sudo lidle install"
}

cmd_set() {
    need_root "set <hours>"
    local HOURS="${1:-}" win was_paused=no
    [ -n "$HOURS" ] || die "usage: sudo lidle set <hours|indefinite>"
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo lidle install ${HOURS}"
    [ -f "$PAUSED" ] && was_paused=yes      # note it before clear_state removes it
    apply_duration "$HOURS"
    clear_state                 # also cancels any active pause
    cmd_tick                    # re-arm immediately instead of waiting up to 60s
    refresh_menu                # ...and let the menu show it without waiting for the poll
    if [ "$APPLIED_HOLD" = indefinite ]; then
        win="indefinite -- the Mac won't sleep on idle or lid-close until you change it"
    else
        win="$(awk -v s="$APPLIED_HOLD" 'BEGIN{printf "%g", s/3600}') h"
    fi
    if [ "$was_paused" = yes ]; then
        echo "Resumed; awake window now ${win}."
    else
        echo "Awake window set to ${win}."
    fi
}

# ---- pause / resume -------------------------------------------------------

cmd_pause() {
    need_root pause
    local arg="${1:-}" secs until
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo lidle install"
    if [ -z "$arg" ]; then
        echo indefinite > "$PAUSED"
        echo "Paused. Normal sleep is in effect until you run: lidle resume"
    else
        secs=$(parse_duration "$arg") || die "bad duration '${arg}' (try 30m, 2h, 90s)"
        until=$(( $(date +%s) + secs ))
        echo "$until" > "$PAUSED"
        echo "Paused for $(fmt_dur "$secs") (until $(date -r "$until" +%H:%M)). Resume early: lidle resume"
    fi
    chmod 644 "$PAUSED"
    restore_pmset               # hand the idle timers back to the user's own values
    cmd_tick                    # apply immediately (tick sees the pause file)
    refresh_menu                # ...and let the menu show it without waiting for the poll
}

cmd_resume() {
    need_root resume
    if [ ! -f "$PAUSED" ]; then
        echo "Not paused — nothing to resume."
        return 0
    fi
    rm -f "$PAUSED"
    apply_sleep_timers          # re-point the idle timers at the awake window
    cmd_tick                    # re-arm immediately
    refresh_menu                # ...and let the menu show it without waiting for the poll
    echo "Resumed. Keep-awake is active again."
}

# ---- status / logs --------------------------------------------------------

# Best-effort phrase for how much longer the Mac will stay awake (used by
# status). Builds on remaining_seconds so status/title/menu agree.
awake_remaining() {
    local secs
    secs=$(remaining_seconds)
    if [ -n "$secs" ]; then
        if [ "$(lid_state)" = open ]; then
            echo "sleeps in ~$(fmt_dur "$secs") if left idle"
        else
            echo "sleeps in ~$(fmt_dur "$secs")"
        fi
    elif [ "$(lid_state)" != open ] && [ "$(external_count)" -gt 0 ]; then
        echo "clamshell with monitor — no countdown"
    fi
}

cmd_status() {
    local now until left awake phrase drift
    now=$(date +%s)

    if [ -f "$PLIST" ]; then
        echo "lidle: installed"
    else
        echo "lidle: not installed (run: sudo lidle install)"
    fi
    echo "  Awake window:  $(hold_human)"
    echo "  Lid:           $(lid_state)"

    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" = indefinite ]; then
            echo "  Paused:        yes (until you run 'resume')"
        else
            left=$(( until - now ))
            if [ "$left" -gt 0 ]; then
                echo "  Paused:        yes ($(fmt_dur "$left") left)"
            else
                echo "  Paused:        expiring on next check"
            fi
        fi
    else
        echo "  Paused:        no"
    fi

    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')
    if [ "${awake:-0}" = 1 ]; then
        phrase=$(awake_remaining)
        if [ -n "$phrase" ]; then
            echo "  Keeping awake: yes  (${phrase})"
        else
            echo "  Keeping awake: yes"
        fi
    else
        echo "  Keeping awake: no (normal sleep in effect)"
    fi

    # A stale daemon looks identical to a working one from the outside, so say so
    # loudly rather than leaving it to be discovered.
    drift=$(version_drift)
    if [ -n "$drift" ]; then
        echo
        echo "  warning: the background service is running lidle ${drift}, but this"
        echo "           is lidle ${VERSION}. The service keeps running the copy at"
        echo "           ${BIN} until you reinstall:"
        echo "               sudo lidle install"
    fi
}

# Emit a SwiftBar menu: title line, then ---, then info + action lines.
# Read-only (no root). Action items shell out to sudo lidle ...,
# made prompt-free by the sudoers drop-in that menu-setup installs.
cmd_menu() {
    local paused awake

    if [ ! -f "$PLIST" ]; then
        echo "⚠️"
        echo "---"
        echo "Not installed"
        echo "Run: sudo lidle install"
        return 0
    fi

    if paused_now; then paused=yes; else paused=no; fi
    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')

    # ---- Title (icon only): sun = holding awake, crescent = not (off or paused).
    # Both are monochrome text-style glyphs, so the item blends with the menu bar. ----
    if [ "${awake:-0}" = 1 ] && [ "$paused" = no ]; then
        echo "☀"
    else
        echo "☾"
    fi
    echo "---"

    # ---- Info ----
    if [ "$paused" = yes ]; then
        echo "Paused"
    else
        echo "Active"
    fi
    echo "Awake window: $(hold_human)"
    echo "---"

    # ---- Set awake window submenu (presets mirror 'Pause for') ----
    echo "Set awake window"
    echo "--1 hour | bash=/usr/bin/sudo param1=$BIN param2=set param3=1 terminal=false refresh=true"
    echo "--3 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=3 terminal=false refresh=true"
    echo "--8 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=8 terminal=false refresh=true"
    echo "--Indefinite | bash=/usr/bin/sudo param1=$BIN param2=set param3=indefinite terminal=false refresh=true"
    echo "--Custom… | bash=$BIN param1=set-prompt terminal=false refresh=true"

    # ---- Pause: single 'Resume' when paused, else a 'Pause for' submenu ----
    if [ "$paused" = yes ]; then
        echo "Resume | bash=/usr/bin/sudo param1=$BIN param2=resume terminal=false refresh=true"
    else
        echo "Pause for"
        echo "--1 hour | bash=/usr/bin/sudo param1=$BIN param2=pause param3=1h terminal=false refresh=true"
        echo "--3 hours | bash=/usr/bin/sudo param1=$BIN param2=pause param3=3h terminal=false refresh=true"
        echo "--8 hours | bash=/usr/bin/sudo param1=$BIN param2=pause param3=8h terminal=false refresh=true"
        echo "--Indefinite | bash=/usr/bin/sudo param1=$BIN param2=pause terminal=false refresh=true"
        echo "--Custom… | bash=$BIN param1=pause-prompt terminal=false refresh=true"
    fi
    echo "---"

    # ---- Footer ----
    echo "Open log | bash=/usr/bin/open param1=$LOG terminal=false"
    echo "Refresh | refresh=true"
    echo "---"
    echo "Remove from menu bar | bash=/usr/bin/sudo param1=$BIN param2=menu-remove terminal=false"
    echo "---"
    echo "Exit lidle | bash=/usr/bin/sudo param1=$BIN param2=quit terminal=false"
}

# Custom… menu action (awake window): prompt for hours, then apply via sudo set.
# Runs as the user (SwiftBar); sudo is prompt-free via the menu sudoers rule.
cmd_set_prompt() {
    local hours
    hours=$(osascript -e 'set h to text returned of (display dialog "Awake window — hours to stay awake before sleeping:" default answer "3" with title "lidle")' 2>/dev/null) || return 0
    [ -n "$hours" ] || return 0
    sudo "$BIN" set "$hours"
}

# Custom… menu action (pause): prompt for a duration, then pause via sudo.
# Runs as the user (SwiftBar); sudo is prompt-free via the menu sudoers rule.
cmd_pause_prompt() {
    local dur
    dur=$(osascript -e 'set d to text returned of (display dialog "Pause for how long? (e.g. 30m, 2h)" default answer "1h" with title "lidle")' 2>/dev/null) || return 0
    [ -n "$dur" ] || return 0
    sudo "$BIN" pause "$dur"
}

# ---- menu setup / teardown ------------------------------------------------

# Write the scoped, passwordless sudoers rule for the menu's actions. `pause` is
# granted both bare (the "Indefinite" pause item) and with one argument (`pause *`,
# the timed presets / Custom…); `set *` likewise carries its numeric argument.
# Validated with visudo before being moved into place (a bad sudoers file can
# break sudo system-wide).
write_sudoers() {
    local user="$1" tmp
    tmp=$(mktemp) || die "mktemp failed"
    printf '%s ALL=(root) NOPASSWD: %s pause, %s pause *, %s resume, %s set *, %s quit, %s menu-remove\n' \
        "$user" "$BIN" "$BIN" "$BIN" "$BIN" "$BIN" "$BIN" > "$tmp"
    if visudo -cf "$tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g wheel "$tmp" "$SUDOERS"
        rm -f "$tmp"
    else
        rm -f "$tmp"
        die "generated sudoers content failed validation; not installing"
    fi
}

# SwiftBar's configured plugin folder, read as the target user.
swiftbar_plugin_dir() {
    sudo -u "$1" defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null
}

# True when we have a controlling terminal we can prompt on.
tty_available() { { : < /dev/tty; } 2>/dev/null; }

# Path to the user's Homebrew binary (Apple Silicon or Intel); empty if none.
user_brew() {
    local b
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$b" ] && { echo "$b"; return 0; }
    done
    return 1
}

# True when SwiftBar.app is installed (system-wide or in the user's ~/Applications).
swiftbar_app_present() {
    local home; home=$(user_home "$1")
    [ -d /Applications/SwiftBar.app ] || [ -d "$home/Applications/SwiftBar.app" ]
}

# Make sure SwiftBar is installed with a plugin folder, offering a Homebrew
# install when it's missing (interactive; TTY only). On success sets PLUGIN_DIR
# and returns 0; otherwise prints guidance and returns 1.
ensure_swiftbar() {
    local user="$1" dir reply brew home

    dir=$(swiftbar_plugin_dir "$user")
    [ -n "$dir" ] && [ -d "$dir" ] && { PLUGIN_DIR="$dir"; return 0; }

    # Offer to install SwiftBar via Homebrew when the app isn't present.
    if ! swiftbar_app_present "$user"; then
        brew=$(user_brew)
        if [ -n "$brew" ] && tty_available; then
            printf 'SwiftBar (needed for the menu bar) is not installed. Install it with Homebrew now? [Y/n] ' > /dev/tty
            read -r reply < /dev/tty || reply=n
            case "$reply" in
                ''|[Yy]*)
                    echo "Installing SwiftBar via Homebrew (this may take a moment)..."
                    sudo -u "$user" "$brew" install --cask swiftbar \
                        || { echo "Homebrew install failed. Install SwiftBar manually: https://swiftbar.app"; return 1; }
                    ;;
                *)  echo "Skipped. Install SwiftBar later, then run: sudo lidle menu-setup"; return 1 ;;
            esac
        else
            echo "SwiftBar is not installed. Install it (https://swiftbar.app or"
            echo "'brew install --cask swiftbar'), then run: sudo lidle menu-setup"
            return 1
        fi
    fi

    # SwiftBar is present (or just installed) but no plugin folder is configured.
    # Bootstrap a default folder and point SwiftBar at it, so the plugin can drop
    # in without SwiftBar's first-run folder-picker dialog.
    dir=$(swiftbar_plugin_dir "$user")
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        home=$(user_home "$user")
        [ -n "$home" ] || { echo "couldn't resolve your home directory for the plugin folder"; return 1; }
        dir="$home/Library/Application Support/SwiftBar/Plugins"
        sudo -u "$user" mkdir -p "$dir"
        sudo -u "$user" defaults write com.ameba.SwiftBar PluginDirectory "$dir"
    fi
    PLUGIN_DIR="$dir"
    return 0
}

# Generate the thin SwiftBar plugin (calls our menu subcommand). The metadata
# comments hide SwiftBar's own footer items (its menu section, About, Run in
# Terminal, Last Updated, Disable Plugin) for a clean dropdown.
write_plugin() {
    local dir="$1" user="$2" path
    path="$dir/$PLUGIN_NAME"
    cat > "$path" <<PLUGIN
#!/bin/bash
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
exec ${BIN} menu
PLUGIN
    chmod 0755 "$path"
    chown "$user" "$path"
}

# A user's home directory (we run as root, so we can't rely on $HOME).
user_home() {
    dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $NF}'
}

# Install a per-user LaunchAgent that starts SwiftBar at login, so the menu is
# present across reboots. The root keep-awake daemon can't do this (daemons have
# no GUI session); a LaunchAgent runs in the user's session. The plist lives in
# ~/Library/LaunchAgents (auto-loaded at login); we also bootstrap it now.
install_menu_agent() {
    local user="$1" home uid plist
    home=$(user_home "$user"); [ -n "$home" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0
    sudo -u "$user" mkdir -p "$home/Library/LaunchAgents"
    plist="$home/Library/LaunchAgents/${AGENT_LABEL}.plist"
    cat > "$plist" <<AGENT
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${AGENT_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-a</string>
        <string>SwiftBar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
AGENT
    chown "$user" "$plist"
    launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
    launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null || true
}

remove_menu_agent() {
    local user="$1" home uid plist
    home=$(user_home "$user"); [ -n "$home" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0
    plist="$home/Library/LaunchAgents/${AGENT_LABEL}.plist"
    launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
    rm -f "$plist"
}

# Remove all menu artifacts for a user: sudoers rule, SwiftBar plugin, login agent.
remove_menu_artifacts() {
    local user="$1" dir
    rm -f "$SUDOERS"
    [ -n "$user" ] || return 0
    dir=$(swiftbar_plugin_dir "$user")
    if [ -n "$dir" ]; then
        rm -f "$dir/$PLUGIN_NAME"
        # If ours was the only plugin, quit SwiftBar so it doesn't replace our
        # menu item with its own placeholder icon. `ls` (no -A) ignores dotfiles
        # like .DS_Store; if other plugins remain, leave SwiftBar running.
        if [ -z "$(ls "$dir" 2>/dev/null)" ]; then
            sudo -u "$user" killall SwiftBar 2>/dev/null || true
        fi
    fi
    remove_menu_agent "$user"
}

cmd_menu_setup() {
    need_root menu-setup
    local user
    user=$(target_user)
    [ -n "$user" ] || die "couldn't determine your user account to scope the sudoers rule"
    [ -f "$PLIST" ] || die "install first: sudo lidle install"

    # Make sure SwiftBar is installed with a plugin folder (offering a Homebrew
    # install if needed) before granting passwordless sudo for the menu.
    ensure_swiftbar "$user" || return 0

    write_sudoers "$user"
    echo "Installed passwordless sudo rule for ${user} (pause / resume / set / quit / menu-remove)."

    write_plugin "$PLUGIN_DIR" "$user"
    install_menu_agent "$user"                                # auto-start SwiftBar at login
    sudo -u "$user" open -g -a SwiftBar 2>/dev/null || true   # ensure SwiftBar is running now
    echo "Installed SwiftBar plugin to ${PLUGIN_DIR}/${PLUGIN_NAME}."
    echo "The menu item will appear now and at every login."
}

cmd_menu_remove() {
    need_root menu-remove
    remove_menu_artifacts "$(target_user)"
    echo "Removed the menu sudo rule, SwiftBar plugin, and login agent."
}

cmd_logs() {
    [ -f "$LOG" ] || die "no log yet at ${LOG} (is it installed?)"
    exec tail -f "$LOG"
}

# ---- usage / dispatch -----------------------------------------------------

usage() {
    cat <<EOF
lidle — give your MacBook an awake window before it sleeps.

Usage:
  sudo lidle install [hours]   Install/enable (prompts for hours if omitted)
  sudo lidle uninstall         Remove and re-enable normal sleep
  sudo lidle quit              Stop everything + restore sleep, but keep it installed
  sudo lidle set <hours>       Change the awake window (e.g. 1.5, or 'indefinite')
  sudo lidle menu-setup        Add the SwiftBar menu bar item (+ passwordless sudo for it)
  sudo lidle menu-remove       Remove the menu bar item and its sudo rule
  sudo lidle pause [dur]       Opt out until 'resume', or for a while (e.g. 30m, 2h)
  sudo lidle resume            Cancel a pause
       lidle status            Show current state
       lidle logs              Follow the daemon log (records each state change)
       lidle version           Print the version
       lidle help              This help
EOF
}

case "${1:-help}" in
    install)        shift; cmd_install "$@" ;;
    uninstall)      shift; cmd_uninstall "$@" ;;
    quit)           cmd_quit ;;
    set)            shift; cmd_set "$@" ;;
    pause)          shift; cmd_pause "$@" ;;
    resume)         shift; cmd_resume "$@" ;;
    status)         shift; cmd_status "$@" ;;
    menu)           cmd_menu ;;
    set-prompt)     cmd_set_prompt ;;
    pause-prompt)   cmd_pause_prompt ;;
    menu-setup)     cmd_menu_setup ;;
    menu-remove)    cmd_menu_remove ;;
    logs)           shift; cmd_logs "$@" ;;
    _tick)          cmd_tick ;;
    version|-v|--version) echo "lidle ${VERSION}" ;;
    help|-h|--help) usage ;;
    *)              echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
