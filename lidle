#!/bin/bash
# lidle — give your MacBook an awake window before it sleeps.
#
# One command for the whole lifecycle. The hidden `_tick` subcommand is what the
# LaunchDaemon runs every 60s; everything else is for humans:
#
#   sudo lidle install [hours]   install/enable (prompts for hours)
#   sudo lidle uninstall         remove, re-enable normal sleep
#   sudo lidle set <hours>       change the awake window
#   sudo lidle pause [dur]       opt out (until 'resume', or e.g. 30m)
#   sudo lidle resume            cancel a pause
#        lidle status            show current state
#        lidle logs              follow the daemon log
#
# No `set -e`: the _tick logic relies on `cond && action` lines and a `grep -c`
# that exits non-zero on a 0 count, which are correct as written but would abort
# under -e. The mutating steps that must succeed use explicit `|| die`.
set -uo pipefail

LABEL="com.lidle"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
BIN="/usr/local/bin/lidle"
CONF="/usr/local/etc/lidle.conf"
SAVED_PMSET="/usr/local/etc/lidle.saved-pmset"
LOG="/var/log/lidle.log"

# Runtime state (created by the daemon as root; world-readable so `status` works
# without sudo).
CLOSED_SINCE="/var/run/lidle.closed-since"
OPEN_SINCE="/var/run/lidle.open-since"
DONE="/var/run/lidle.done"
PREV_LID="/var/run/lidle.prev-lid"
PAUSED="/var/run/lidle.paused"
MODE="/var/run/lidle.mode"
SUDOERS="/etc/sudoers.d/lidle"
PLUGIN_NAME="lidle.5s.sh"
AGENT_LABEL="com.lidle.menu"

VERSION="1.0.0"

# ---- small helpers --------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "this command needs root. Re-run: sudo lidle ${1:-<cmd>}"
}

# The GUI user to scope per-user actions to. Uses $SUDO_USER when run via sudo,
# else the current console user (so it also works when launched as root by the
# Spotlight app via osascript, where $SUDO_USER is unset).
target_user() {
    echo "${SUDO_USER:-$(stat -f%Su /dev/console 2>/dev/null)}"
}

# Seconds -> "2 h 14 m" / "45 m" / "30 s".
fmt_dur() {
    local s="$1" h m
    h=$(( s / 3600 )); m=$(( (s % 3600) / 60 ))
    if [ "$h" -gt 0 ]; then
        if [ "$m" -gt 0 ]; then echo "${h} h ${m} m"; else echo "${h} h"; fi
    elif [ "$m" -gt 0 ]; then
        echo "${m} m"
    else
        echo "${s} s"
    fi
}

# Duration string -> seconds. Accepts <number>[s|m|h]; no suffix = minutes.
parse_duration() {
    local in="$1" num unit
    [[ "$in" =~ ^([0-9]+(\.[0-9]+)?)([smh]?)$ ]] || return 1
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[3]}"
    case "$unit" in
        s)     awk -v n="$num" 'BEGIN{printf "%d", n+0.5}' ;;
        h)     awk -v n="$num" 'BEGIN{printf "%d", n*3600+0.5}' ;;
        m|"")  awk -v n="$num" 'BEGIN{printf "%d", n*60+0.5}' ;;
    esac
}

clear_state() { rm -f "$CLOSED_SINCE" "$OPEN_SINCE" "$PREV_LID" "$DONE" "$PAUSED" "$MODE"; }

# Append a timestamped line to the log, but only when the worker's mode actually
# changes (the daemon ticks every 60s; without this the log would repeat the same
# line forever). $1 is a short mode key compared against the last one; $2 is the
# human-readable line. Writes straight to $LOG so inline ticks don't print to the
# terminal.
log_mode() {
    local mode="$1" prev
    prev=$(cat "$MODE" 2>/dev/null || true)
    [ "$mode" = "$prev" ] && return 0
    echo "$mode" > "$MODE"
    printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$2" >> "$LOG"
}

# Current awake window from the config: seconds, the literal "indefinite", or
# empty when unconfigured (there is no built-in default — it's set at install).
hold_seconds() {
    local HOLD=""
    [ -r "$CONF" ] && . "$CONF"
    echo "$HOLD"
}

# Awake window for display: "not set", "indefinite", or e.g. "3 h".
hold_human() {
    local h
    h=$(hold_seconds)
    if   [ -z "$h" ];            then echo "not set"
    elif [ "$h" = indefinite ];  then echo indefinite
    else awk -v s="$h" 'BEGIN{printf "%g h", s/3600}'; fi
}

lid_state() {
    # Capture ioreg's output and string-match it rather than piping into `grep -q`:
    # grep -q exits on the first match and SIGPIPEs ioreg (exit 141), which
    # `set -o pipefail` then surfaces as a pipeline failure — making the `if`
    # wrongly fall through and report "open" while the lid is actually shut.
    case "$(ioreg -r -k AppleClamshellState -d 4)" in
        *'"AppleClamshellState" = Yes'*) echo closed ;;
        *)                               echo open ;;
    esac
}

# Count connected external displays (meaningful when the lid is shut).
external_count() {
    system_profiler SPDisplaysDataType 2>/dev/null | grep -c "Resolution:" || true
}

# True (0) when a pause is in effect right now. Read-only and honors a timed
# pause's expiry, so status/menu don't keep showing "paused" past its end (the
# daemon reaps the file on its next tick).
paused_now() {
    local until
    [ -f "$PAUSED" ] || return 1
    until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
    [ "$until" = indefinite ] && return 0
    [ "$until" -gt "$(date +%s)" ] 2>/dev/null
}

# Seconds until the Mac may sleep given the current state, or empty when there
# is no active countdown (clamshell+monitor, awake window already elapsed, etc.).
# Mirrors the decision cmd_tick makes; read-only.
remaining_seconds() {
    local now HOLD lid idle_ns idle since_open left
    now=$(date +%s)
    HOLD=$(hold_seconds)
    [ -z "$HOLD" ] && return 0               # unconfigured -> no countdown
    [ "$HOLD" = indefinite ] && return 0     # never sleeps -> no countdown
    lid=$(lid_state)
    if [ "$lid" = open ]; then
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        if [ -f "$OPEN_SINCE" ]; then
            since_open=$(( now - $(cat "$OPEN_SINCE") ))
            [ "$since_open" -lt "$idle" ] && idle=$since_open
        fi
        left=$(( HOLD - idle ))
        [ "$left" -gt 0 ] && echo "$left"
    elif [ "$(external_count)" -gt 0 ]; then
        :   # clamshell with monitor: no countdown
    elif [ -f "$CLOSED_SINCE" ]; then
        left=$(( HOLD - ( now - $(cat "$CLOSED_SINCE") ) ))
        [ "$left" -gt 0 ] && echo "$left"
    fi
}

# ---- configuration / files ------------------------------------------------

# Snapshot the user's current sleep timers (AC + battery) the first time we touch
# them, so uninstall/quit can put back exactly what was there. A no-op once the
# snapshot exists, so re-installing or changing the awake window never clobbers
# the true originals.
save_pmset() {
    [ -e "$SAVED_PMSET" ] && return 0
    install -d -m 755 /usr/local/etc
    pmset -g custom | awk '
        /^AC Power:/      { src="c"; next }
        /^Battery Power:/ { src="b"; next }
        src && $1=="sleep"        { print src, "sleep", $2 }
        src && $1=="disksleep"    { print src, "disksleep", $2 }
        src && $1=="displaysleep" { print src, "displaysleep", $2 }
    ' > "$SAVED_PMSET"
    chmod 644 "$SAVED_PMSET"
}

# Put the snapshotted sleep timers back. No-op if we never captured them.
restore_pmset() {
    [ -r "$SAVED_PMSET" ] || return 0
    local src key val
    while read -r src key val; do
        [ -n "$src" ] && pmset -"$src" "$key" "$val"
    done < "$SAVED_PMSET"
}

# Write conf + matching pmset timers for HOURS. Leaves APPLIED_HOLD / APPLIED_DISP
# set for the caller's summary.
apply_duration() {
    local HOURS="$1" HOLD_SECONDS SLEEP_MIN DISP_MIN
    if [ "$HOURS" = indefinite ]; then
        install -d -m 755 /usr/local/etc
        printf 'HOLD=indefinite\n' > "$CONF"; chmod 644 "$CONF"
        save_pmset                  # capture the originals once, before we overwrite
        pmset -a sleep 0            # 0 = never idle-sleep
        pmset -a disksleep 0
        pmset -a displaysleep 10    # screen still turns off after 10 min
        APPLIED_HOLD=indefinite
        APPLIED_DISP=10
        return 0
    fi
    awk -v h="$HOURS" 'BEGIN{exit !(h+0>0)}' \
        || die "HOURS must be a positive number or 'indefinite' (got '${HOURS}')"
    HOLD_SECONDS=$(awk -v h="$HOURS" 'BEGIN{printf "%d", (h*3600)+0.5}')
    SLEEP_MIN=$(awk -v s="$HOLD_SECONDS" 'BEGIN{m=int((s/60)+0.5); if(m<1)m=1; print m}')
    DISP_MIN=$(awk -v m="$SLEEP_MIN" 'BEGIN{ if(m>10) print 10; else {d=m-1; if(d<1)d=1; print d} }')

    install -d -m 755 /usr/local/etc
    printf 'HOLD=%s\n' "$HOLD_SECONDS" > "$CONF"
    chmod 644 "$CONF"

    save_pmset                  # capture the originals once, before we overwrite

    # Idle sleep timer == awake window, so the lid-open case sleeps when the
    # daemon releases `disablesleep`. disksleep matched for consistency.
    pmset -a sleep "$SLEEP_MIN"
    pmset -a disksleep "$SLEEP_MIN"
    pmset -a displaysleep "$DISP_MIN"

    APPLIED_HOLD=$HOLD_SECONDS
    APPLIED_DISP=$DISP_MIN
}

write_plist() {
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BIN}</string>
        <string>_tick</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOG}</string>
    <key>StandardErrorPath</key>
    <string>${LOG}</string>
</dict>
</plist>
PLIST
    chmod 644 "$PLIST"
    chown root:wheel "$PLIST"
}

# ---- _tick: the per-60s worker (run as root by launchd) -------------------
#
# Delay any natural system sleep by the awake window, then ALLOW (not force) it,
# resetting whenever the computer is used again. `disablesleep` is held on so a
# lid-close can't race us to sleep; at the awake-window mark we set it 0 and let macOS
# sleep on its own. Because we only *allow* sleep, a power assertion (playback,
# a download, screen sharing) still keeps the Mac awake past the mark, which is
# correct: that sleep wasn't going to happen normally either.
cmd_tick() {
    local now HOLD lid prev idle_ns idle since_open ext until
    now=$(date +%s)

    # ---- Pause guard: while paused, behave like a normal Mac ----
    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" != indefinite ] && [ "$until" -le "$now" ] 2>/dev/null; then
            rm -f "$PAUSED"                  # expired -> fall through to normal logic
        else
            log_mode paused "paused — letting macOS sleep normally"
            pmset -a disablesleep 0          # paused -> let macOS sleep normally
            return 0
        fi
    fi

    HOLD=""
    [ -r "$CONF" ] && . "$CONF"

    # ---- No window configured (missing/empty conf): behave like a normal Mac ----
    if [ -z "$HOLD" ]; then
        log_mode unconfigured "no awake window configured — letting macOS sleep normally"
        pmset -a disablesleep 0
        return 0
    fi

    # ---- Indefinite awake window: hold awake forever, never count down ----
    if [ "$HOLD" = indefinite ]; then
        log_mode indefinite "awake window is indefinite — holding awake (never sleeps)"
        pmset -a disablesleep 1
        return 0
    fi

    lid=$(lid_state)
    prev=$(cat "$PREV_LID" 2>/dev/null || true)
    echo "$lid" > "$PREV_LID"

    if [ "$lid" = open ]; then
        # ---- Lid OPEN ----
        rm -f "$CLOSED_SINCE" "$DONE"
        if [ "$prev" != open ]; then
            echo "$now" > "$OPEN_SINCE"          # just opened/woke/first run = in use
        fi
        [ -f "$OPEN_SINCE" ] || echo "$now" > "$OPEN_SINCE"
        idle_ns=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}')
        idle=$(( ${idle_ns:-0} / 1000000000 ))
        since_open=$(( now - $(cat "$OPEN_SINCE") ))
        [ "$since_open" -lt "$idle" ] && idle=$since_open   # idle = min(HID idle, time open)
        if [ "$idle" -ge "$HOLD" ]; then
            log_mode open-idle "lid open, idle past the awake window — sleep allowed"
            pmset -a disablesleep 0
        else
            log_mode open-hold "lid open — holding awake (awake window running)"
            pmset -a disablesleep 1
        fi
    else
        # ---- Lid SHUT (built-in panel off -> this counts external monitors) ----
        rm -f "$OPEN_SINCE"
        ext=$(system_profiler SPDisplaysDataType 2>/dev/null | grep -c "Resolution:")
        if [ "$ext" -gt 0 ]; then
            rm -f "$CLOSED_SINCE" "$DONE"        # clamshell work: stay awake, no countdown
            log_mode clamshell "lid shut with external monitor — holding awake (clamshell)"
            pmset -a disablesleep 1
        elif [ -f "$DONE" ]; then
            log_mode shut-done "lid shut, no monitor, awake window elapsed — sleep allowed"
            # already released this session; hands off (no pmset change)
        elif [ ! -f "$CLOSED_SINCE" ]; then
            echo "$now" > "$CLOSED_SINCE"        # just unplugged / closed with no monitor
            log_mode shut-hold "lid shut, no monitor — holding awake (awake window running)"
            pmset -a disablesleep 1
        elif [ $(( now - $(cat "$CLOSED_SINCE") )) -ge "$HOLD" ]; then
            rm -f "$CLOSED_SINCE"
            touch "$DONE"
            log_mode shut-done "lid shut, no monitor, awake window elapsed — sleep allowed"
            pmset -a disablesleep 0              # window up: lid shut -> macOS sleeps now
        else
            log_mode shut-hold "lid shut, no monitor — holding awake (awake window running)"
            pmset -a disablesleep 1
        fi
    fi
}

# ---- install / uninstall / set --------------------------------------------

print_install_summary() {
    local HOURS="$1"
    echo "Installed and loaded lidle."
    echo
    if [ "${HOURS}" = indefinite ]; then
        echo "Your Mac now stays awake whenever it would otherwise sleep -- closing the"
        echo "lid, unplugging a monitor, or sitting idle -- with no time limit, until you"
        echo "change the window or pause."
        echo
        echo "Heads up: a closed MacBook with no external display stays awake (and warm)"
        echo "the whole time -- keep an eye on it."
    else
        echo "Your Mac now waits ${HOURS} hour(s) before sleeping whenever it would"
        echo "otherwise sleep -- closing the lid, unplugging a monitor, or sitting idle."
        echo "After that it sleeps as usual; using it again resets the timer."
        echo
        echo "Heads up: while the window is active, a closed MacBook with no external"
        echo "display stays awake (and warm) until the window ends -- keep an eye on it."
    fi
    echo
    echo "Check state anytime:  lidle status   (or the menu bar item)"
}

cmd_install() {
    need_root install
    # Warn (don't block) if there's no lid/clamshell sensor — lidle
    # is meant for MacBooks, but a false negative must never stop a real install.
    # Match the captured string, not `... | grep -q` (see lid_state for why).
    case "$(ioreg -r -k AppleClamshellState -d 4)" in
        *AppleClamshellState*) : ;;
        *) echo "warning: no lid sensor detected; lidle is meant for" >&2
           echo "         MacBooks. Continuing anyway." >&2 ;;
    esac
    local HOURS="${1:-}" src
    if [ -z "$HOURS" ]; then
        if [ -r "$CONF" ]; then
            HOURS=$(hold_seconds)                                              # reuse existing window
            [ "$HOURS" = indefinite ] || HOURS=$(awk -v s="$HOURS" 'BEGIN{printf "%g", s/3600}')
        elif { : < /dev/tty; } 2>/dev/null; then     # a real terminal we can prompt on
            printf 'Hours to stay awake before sleeping, or "indefinite": ' > /dev/tty
            read -r HOURS < /dev/tty || true
        fi
    fi
    [ -n "$HOURS" ] || die "no awake window given. Pass hours (e.g. 'sudo lidle install 3') or 'indefinite'."

    # Resolve our own path so we can copy onto PATH (skip if already there).
    case "$0" in
        */*) src=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
        *)   src=$(command -v "$0") ;;
    esac
    install -d -m 755 /usr/local/bin
    if [ "$src" != "$BIN" ]; then
        install -m 755 -o root -g wheel "$src" "$BIN" || die "could not install ${BIN}"
    fi

    apply_duration "$HOURS"
    write_plist
    clear_state

    launchctl bootout system "$PLIST" 2>/dev/null || true
    launchctl bootstrap system "$PLIST" || die "launchctl bootstrap failed"

    print_install_summary "$HOURS"
}

# Stop the daemon, remove its plist + state + menu artifacts, and restore normal
# sleep. Shared by quit and uninstall.
teardown() {
    launchctl bootout system "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    clear_state

    # Remove menu artifacts (sudoers rule, SwiftBar plugin, login agent) if
    # menu-setup ran. No SwiftBar refresh URL here: deleting the plugin file is
    # enough (SwiftBar watches the folder) and a refresh URL would pop it forward.
    remove_menu_artifacts "$(target_user)"

    restore_pmset              # put the original sleep / display timers back
    pmset -a disablesleep 0    # and re-enable normal sleep
}

cmd_uninstall() {
    need_root uninstall
    teardown
    rm -f "$BIN" "$SAVED_PMSET" "$CONF" "$LOG"   # full wipe (quit keeps conf/log)
    echo "Removed ${LABEL}, re-enabled normal sleep, and restored the sleep /"
    echo "disksleep / displaysleep timers to the values you had before installing."

    # Confirm a clean removal: every file/service lidle creates should be gone.
    local f clean=yes
    for f in "$PLIST" "$BIN" "$CONF" "$SAVED_PMSET" "$LOG" "$SUDOERS" \
             "$CLOSED_SINCE" "$OPEN_SINCE" "$DONE" "$PREV_LID" "$PAUSED" "$MODE"; do
        [ -e "$f" ] || continue
        [ "$clean" = yes ] && { echo; echo "warning: these artifacts are still present:"; }
        clean=no; echo "  $f"
    done
    if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
        [ "$clean" = yes ] && { echo; echo "warning: these artifacts are still present:"; }
        clean=no; echo "  daemon still loaded: ${LABEL}"
    fi
    [ "$clean" = yes ] && echo "Verified: all lidle files and services removed."
}

# Stop everything but keep the binary installed (re-enable later with install).
cmd_quit() {
    need_root quit
    teardown
    echo "lidle stopped; normal sleep restored."
    echo "Still installed — re-enable anytime with: sudo lidle install"
}

cmd_set() {
    need_root "set <hours>"
    local HOURS="${1:-}" win was_paused=no
    [ -n "$HOURS" ] || die "usage: sudo lidle set <hours|indefinite>"
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo lidle install ${HOURS}"
    [ -f "$PAUSED" ] && was_paused=yes      # note it before clear_state removes it
    apply_duration "$HOURS"
    clear_state                 # also cancels any active pause
    cmd_tick                    # re-arm immediately instead of waiting up to 60s
    if [ "$APPLIED_HOLD" = indefinite ]; then
        win="indefinite -- the Mac won't sleep on idle or lid-close until you change it"
    else
        win="$(awk -v s="$APPLIED_HOLD" 'BEGIN{printf "%g", s/3600}') h (screen off after ${APPLIED_DISP} min)"
    fi
    if [ "$was_paused" = yes ]; then
        echo "Resumed; awake window now ${win}."
    else
        echo "Awake window set to ${win}."
    fi
}

# ---- pause / resume -------------------------------------------------------

cmd_pause() {
    need_root pause
    local arg="${1:-}" secs until
    [ -f "$PLIST" ] || die "not installed yet -- run: sudo lidle install"
    if [ -z "$arg" ]; then
        echo indefinite > "$PAUSED"
        echo "Paused. Normal sleep is in effect until you run: lidle resume"
    else
        secs=$(parse_duration "$arg") || die "bad duration '${arg}' (try 30m, 2h, 90s)"
        until=$(( $(date +%s) + secs ))
        echo "$until" > "$PAUSED"
        echo "Paused for $(fmt_dur "$secs") (until $(date -r "$until" +%H:%M)). Resume early: lidle resume"
    fi
    chmod 644 "$PAUSED"
    cmd_tick                    # apply immediately (tick sees the pause file)
}

cmd_resume() {
    need_root resume
    if [ ! -f "$PAUSED" ]; then
        echo "Not paused — nothing to resume."
        return 0
    fi
    rm -f "$PAUSED"
    cmd_tick                    # re-arm immediately
    echo "Resumed. Keep-awake is active again."
}

# ---- status / logs --------------------------------------------------------

# Best-effort phrase for how much longer the Mac will stay awake (used by
# status). Builds on remaining_seconds so status/title/menu agree.
awake_remaining() {
    local secs
    secs=$(remaining_seconds)
    if [ -n "$secs" ]; then
        if [ "$(lid_state)" = open ]; then
            echo "sleeps in ~$(fmt_dur "$secs") if left idle"
        else
            echo "sleeps in ~$(fmt_dur "$secs")"
        fi
    elif [ "$(lid_state)" != open ] && [ "$(external_count)" -gt 0 ]; then
        echo "clamshell with monitor — no countdown"
    fi
}

cmd_status() {
    local now until left awake phrase
    now=$(date +%s)

    if [ -f "$PLIST" ]; then
        echo "lidle: installed"
    else
        echo "lidle: not installed (run: sudo lidle install)"
    fi
    echo "  Awake window:  $(hold_human)"
    echo "  Lid:           $(lid_state)"

    if [ -f "$PAUSED" ]; then
        until=$(cat "$PAUSED" 2>/dev/null || echo indefinite)
        if [ "$until" = indefinite ]; then
            echo "  Paused:        yes (until you run 'resume')"
        else
            left=$(( until - now ))
            if [ "$left" -gt 0 ]; then
                echo "  Paused:        yes ($(fmt_dur "$left") left)"
            else
                echo "  Paused:        expiring on next check"
            fi
        fi
    else
        echo "  Paused:        no"
    fi

    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')
    if [ "${awake:-0}" = 1 ]; then
        phrase=$(awake_remaining)
        if [ -n "$phrase" ]; then
            echo "  Keeping awake: yes  (${phrase})"
        else
            echo "  Keeping awake: yes"
        fi
    else
        echo "  Keeping awake: no (normal sleep in effect)"
    fi
}

# Emit a SwiftBar menu: title line, then ---, then info + action lines.
# Read-only (no root). Action items shell out to sudo lidle ...,
# made prompt-free by the sudoers drop-in that menu-setup installs.
cmd_menu() {
    local paused awake phrase

    if [ ! -f "$PLIST" ]; then
        echo "⚠️"
        echo "---"
        echo "Not installed"
        echo "Run: sudo lidle install"
        return 0
    fi

    if paused_now; then paused=yes; else paused=no; fi
    awake=$(pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2; exit}')

    # ---- Title (icon only): sun = holding awake, moon = not (off or paused) ----
    if [ "${awake:-0}" = 1 ] && [ "$paused" = no ]; then
        echo "☀"
    else
        echo "🌙"
    fi
    echo "---"

    # ---- Info ----
    if [ "$paused" = yes ]; then
        echo "Paused"
    else
        echo "Active"
    fi
    echo "Awake window: $(hold_human)"
    if [ "$paused" = no ]; then
        phrase=$(awake_remaining)               # same countdown 'status' shows
        [ -n "$phrase" ] && echo "$phrase"
    fi
    echo "---"

    # ---- Set awake window submenu (presets mirror 'Pause for') ----
    echo "Set awake window"
    echo "--1 hour | bash=/usr/bin/sudo param1=$BIN param2=set param3=1 terminal=false refresh=true"
    echo "--3 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=3 terminal=false refresh=true"
    echo "--8 hours | bash=/usr/bin/sudo param1=$BIN param2=set param3=8 terminal=false refresh=true"
    echo "--Indefinite | bash=/usr/bin/sudo param1=$BIN param2=set param3=indefinite terminal=false refresh=true"
    echo "--Custom… | bash=$BIN param1=set-prompt terminal=false refresh=true"

    # ---- Pause: single 'Resume' when paused, else a 'Pause for' submenu ----
    if [ "$paused" = yes ]; then
        echo "Resume | bash=/usr/bin/sudo param1=$BIN param2=resume terminal=false refresh=true"
    else
        echo "Pause for"
        echo "--1 hour | bash=/usr/bin/sudo param1=$BIN param2=pause param3=1h terminal=false refresh=true"
        echo "--3 hours | bash=/usr/bin/sudo param1=$BIN param2=pause param3=3h terminal=false refresh=true"
        echo "--8 hours | bash=/usr/bin/sudo param1=$BIN param2=pause param3=8h terminal=false refresh=true"
        echo "--Indefinite | bash=/usr/bin/sudo param1=$BIN param2=pause terminal=false refresh=true"
        echo "--Custom… | bash=$BIN param1=pause-prompt terminal=false refresh=true"
    fi
    echo "---"

    # ---- Footer ----
    echo "Open log | bash=/usr/bin/open param1=$LOG terminal=false"
    echo "Refresh | refresh=true"
    echo "---"
    echo "Quit lidle | bash=/usr/bin/sudo param1=$BIN param2=quit terminal=false"
}

# Custom… menu action (awake window): prompt for hours, then apply via sudo set.
# Runs as the user (SwiftBar); sudo is prompt-free via the menu sudoers rule.
cmd_set_prompt() {
    local hours
    hours=$(osascript -e 'set h to text returned of (display dialog "Awake window — hours to stay awake before sleeping:" default answer "3" with title "lidle")' 2>/dev/null) || return 0
    [ -n "$hours" ] || return 0
    sudo "$BIN" set "$hours"
}

# Custom… menu action (pause): prompt for a duration, then pause via sudo.
# Runs as the user (SwiftBar); sudo is prompt-free via the menu sudoers rule.
cmd_pause_prompt() {
    local dur
    dur=$(osascript -e 'set d to text returned of (display dialog "Pause for how long? (e.g. 30m, 2h)" default answer "1h" with title "lidle")' 2>/dev/null) || return 0
    [ -n "$dur" ] || return 0
    sudo "$BIN" pause "$dur"
}

# ---- menu setup / teardown ------------------------------------------------

# Write the scoped, passwordless sudoers rule for the menu's actions. `pause` is
# granted both bare (the "Indefinite" pause item) and with one argument (`pause *`,
# the timed presets / Custom…); `set *` likewise carries its numeric argument.
# Validated with visudo before being moved into place (a bad sudoers file can
# break sudo system-wide).
write_sudoers() {
    local user="$1" tmp
    tmp=$(mktemp) || die "mktemp failed"
    printf '%s ALL=(root) NOPASSWD: %s pause, %s pause *, %s resume, %s set *, %s quit\n' \
        "$user" "$BIN" "$BIN" "$BIN" "$BIN" "$BIN" > "$tmp"
    if visudo -cf "$tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g wheel "$tmp" "$SUDOERS"
        rm -f "$tmp"
    else
        rm -f "$tmp"
        die "generated sudoers content failed validation; not installing"
    fi
}

# SwiftBar's configured plugin folder, read as the target user.
swiftbar_plugin_dir() {
    sudo -u "$1" defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null
}

# Generate the thin SwiftBar plugin (calls our menu subcommand). The metadata
# comments hide SwiftBar's own footer items (its menu section, About, Run in
# Terminal, Last Updated, Disable Plugin) for a clean dropdown.
write_plugin() {
    local dir="$1" user="$2" path
    path="$dir/$PLUGIN_NAME"
    cat > "$path" <<PLUGIN
#!/bin/bash
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
exec ${BIN} menu
PLUGIN
    chmod 0755 "$path"
    chown "$user" "$path"
}

# A user's home directory (we run as root, so we can't rely on $HOME).
user_home() {
    dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $NF}'
}

# Install a per-user LaunchAgent that starts SwiftBar at login, so the menu is
# present across reboots. The root keep-awake daemon can't do this (daemons have
# no GUI session); a LaunchAgent runs in the user's session. The plist lives in
# ~/Library/LaunchAgents (auto-loaded at login); we also bootstrap it now.
install_menu_agent() {
    local user="$1" home uid plist
    home=$(user_home "$user"); [ -n "$home" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0
    sudo -u "$user" mkdir -p "$home/Library/LaunchAgents"
    plist="$home/Library/LaunchAgents/${AGENT_LABEL}.plist"
    cat > "$plist" <<AGENT
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${AGENT_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-a</string>
        <string>SwiftBar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
AGENT
    chown "$user" "$plist"
    launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
    launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null || true
}

remove_menu_agent() {
    local user="$1" home uid plist
    home=$(user_home "$user"); [ -n "$home" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0
    plist="$home/Library/LaunchAgents/${AGENT_LABEL}.plist"
    launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
    rm -f "$plist"
}

# Remove all menu artifacts for a user: sudoers rule, SwiftBar plugin, login agent.
remove_menu_artifacts() {
    local user="$1" dir
    rm -f "$SUDOERS"
    [ -n "$user" ] || return 0
    dir=$(swiftbar_plugin_dir "$user")
    if [ -n "$dir" ]; then
        rm -f "$dir/$PLUGIN_NAME"
        # If ours was the only plugin, quit SwiftBar so it doesn't replace our
        # menu item with its own placeholder icon. `ls` (no -A) ignores dotfiles
        # like .DS_Store; if other plugins remain, leave SwiftBar running.
        if [ -z "$(ls "$dir" 2>/dev/null)" ]; then
            sudo -u "$user" killall SwiftBar 2>/dev/null || true
        fi
    fi
    remove_menu_agent "$user"
}

cmd_menu_setup() {
    need_root menu-setup
    local user dir
    user=$(target_user)
    [ -n "$user" ] || die "couldn't determine your user account to scope the sudoers rule"
    [ -f "$PLIST" ] || die "install first: sudo lidle install"

    # Locate SwiftBar's plugin folder first: don't grant passwordless sudo for a
    # menu we can't actually install yet.
    dir=$(swiftbar_plugin_dir "$user")
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        echo "SwiftBar plugin folder not found."
        echo "Install SwiftBar (https://swiftbar.app), set its Plugin Folder, then re-run:"
        echo "  sudo lidle menu-setup"
        return 0
    fi

    write_sudoers "$user"
    echo "Installed passwordless sudo rule for ${user} (pause / resume / set / quit)."

    write_plugin "$dir" "$user"
    install_menu_agent "$user"                                # auto-start SwiftBar at login
    sudo -u "$user" open -g -a SwiftBar 2>/dev/null || true   # ensure SwiftBar is running now
    echo "Installed SwiftBar plugin to ${dir}/${PLUGIN_NAME}."
    echo "The menu item will appear now and at every login."
}

cmd_menu_remove() {
    need_root menu-remove
    remove_menu_artifacts "$(target_user)"
    echo "Removed the menu sudo rule, SwiftBar plugin, and login agent."
}

cmd_logs() {
    [ -f "$LOG" ] || die "no log yet at ${LOG} (is it installed?)"
    exec tail -f "$LOG"
}

# ---- usage / dispatch -----------------------------------------------------

usage() {
    cat <<EOF
lidle — give your MacBook an awake window before it sleeps.

Usage:
  sudo lidle install [hours]   Install/enable (prompts for hours if omitted)
  sudo lidle uninstall         Remove and re-enable normal sleep
  sudo lidle quit              Stop everything + restore sleep, but keep it installed
  sudo lidle set <hours>       Change the awake window (e.g. 1.5, or 'indefinite')
  sudo lidle menu-setup        Add the SwiftBar menu bar item (+ passwordless sudo for it)
  sudo lidle menu-remove       Remove the menu bar item and its sudo rule
  sudo lidle pause [dur]       Opt out until 'resume', or for a while (e.g. 30m, 2h)
  sudo lidle resume            Cancel a pause
       lidle status            Show current state
       lidle logs              Follow the daemon log (records each state change)
       lidle version           Print the version
       lidle help              This help
EOF
}

case "${1:-help}" in
    install)        shift; cmd_install "$@" ;;
    uninstall)      shift; cmd_uninstall "$@" ;;
    quit)           cmd_quit ;;
    set)            shift; cmd_set "$@" ;;
    pause)          shift; cmd_pause "$@" ;;
    resume)         shift; cmd_resume "$@" ;;
    status)         shift; cmd_status "$@" ;;
    menu)           cmd_menu ;;
    set-prompt)     cmd_set_prompt ;;
    pause-prompt)   cmd_pause_prompt ;;
    menu-setup)     cmd_menu_setup ;;
    menu-remove)    cmd_menu_remove ;;
    logs)           shift; cmd_logs "$@" ;;
    _tick)          cmd_tick ;;
    version|-v|--version) echo "lidle ${VERSION}" ;;
    help|-h|--help) usage ;;
    *)              echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
